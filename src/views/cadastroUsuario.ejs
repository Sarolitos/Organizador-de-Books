<!DOCTYPE html>
<html lang="pt-BR">
<head>

<meta charset="UTF-8">

<title>Cadastro</title>

<style>

body{
    font-family:Arial;
    margin:40px;
}

input{
    width:300px;
    padding:10px;
    margin-bottom:10px;
}

button{
    padding:10px;
}

</style>

</head>
<body>

<h1>Cadastro de Usuário</h1>

<form action="/cadastro" method="POST">

    <input
        type="text"
        name="nome"
        placeholder="Nome"
        required
    >

    <br>

    <input
        type="email"
        name="email"
        placeholder="Email"
        required
    >

    <br>

    <input
        type="password"
        name="senha"
        placeholder="Senha"
        required
    >

    <br>

    <button type="submit">
        Cadastrar
    </button>

</form>

<br>

<a href="/login">
    Voltar ao Login
</a>

</body>
</html>