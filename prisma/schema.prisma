generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String

  livros    Livro[]

  createdAt DateTime @default(now())
}

model Livro {
  id             Int      @id @default(autoincrement())
  titulo         String
  autor          String
  genero         String
  anoPublicacao  Int
  sinopse        String

  usuarioId      Int
  usuario        Usuario @relation(fields: [usuarioId], references: [id])

  createdAt      DateTime @default(now())
}